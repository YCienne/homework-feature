{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ImageBucketAccess",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::learnairium-bucket"
    },
    {
      "Sid": "ImageObjectAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::learnairium-bucket/*"
    },
    {
      "Sid": "BedrockClaudeHaikuInvoke",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": "arn:aws:bedrock:eu-west-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
    }
  ]
}
