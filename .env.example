# ── LLM Provider ──────────────────────────────────────────────────────────────
# Default provider is anthropic (requires ANTHROPIC_API_KEY). Alternatives: gemini | deepseek | anthropic_aws
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
LLM_MODEL_GEMINI=
LLM_TIMEOUT_MS=15000
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
# LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_MODEL_DEEPSEEK=deepseek-chat

# LLM_PROVIDER=bedrock — IAM/SigV4 via the AWS default credential chain (the
# EC2 instance's attached role in production), no API key. bedrock_region
# must be a region where the model is enabled in the account's Bedrock console.
# LLM_PROVIDER=bedrock
BEDROCK_REGION=
BEDROCK_MODEL_ID=

# ── AWS Cognito (Authentication) ───────────────────────────────────────────────
COGNITO_USER_POOL_ID=af-south-1_AnsxEBThZ
COGNITO_REGION=af-south-1
COGNITO_CLIENT_ID=your-app-client-id-here
STUDENT_ID_FIELD=sub

# ── Dev auth bypass ───────────────────────────────────────────────────────────
# Only active when ENVIRONMENT=development. Leave empty to disable it (default).
# If you set one, generate a fresh random value per deployment — never reuse a
# value that has ever been committed to git:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DEV_BYPASS_TOKEN=

# ── Redis (Session Store) ──────────────────────────────────────────────────────
#REDIS_URL=redis://host.docker.internal:6379
#REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379
# Local dev (docker-compose MySQL, schema `learnairium`):
DATABASE_URL=mysql+pymysql://root:devpassword@localhost:3307/learnairium
SESSION_TTL_SECONDS=86400

# Database (Concept Tracking) 
# Production (shared AWS RDS schema) - uncomment and replace the local URL above:
# DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<rds-endpoint>:3306/learnairium
DATABASE_POOL_SIZE=10

# AWS S3 (Image Uploads) 
IMAGE_STORAGE_PROVIDER=s3
IMAGE_BUCKET_NAME=learnairium-bucket
IMAGE_S3_PREFIX=HOMEWORK_IMAGE
IMAGE_MAX_SIZE_MB=5
AWS_REGION=af-south-1

# Usage Limits 
DAILY_SESSION_LIMIT=5
MAX_STEPS_DEFAULT=5
MAX_STEPS_HARD_CAP=7

# Service Config
ENVIRONMENT=development
PORT=2095
LOG_LEVEL=info

# ── docker-compose.prod.yml only (interim hosting — see docs/HOSTING.md) ──────
# Not read by the app itself; used for compose variable substitution.
# MYSQL_ROOT_PASSWORD=
# SITE_ADDRESS=
