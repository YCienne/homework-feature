# ── API ────────────────────────────────────────────────────────────────────────
VITE_HOMEWORK_API_URL=/homework

# ── Mock mode ──────────────────────────────────────────────────────────────────
# true  = uses Gemini directly from browser (no backend needed — for demo/dev)
# false = uses the real homework-service backend
VITE_USE_MOCK=true

# ── Gemini API Key (only needed when VITE_USE_MOCK=true) ──────────────────────
# WARNING: this is baked into the built JS bundle and visible to anyone who
# opens the site — fine for a local demo, never use a real key for a hosted one.
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ── Dev auth bypass (only needed when VITE_USE_MOCK=false) ────────────────────
# Must match the backend's DEV_BYPASS_TOKEN exactly (see homework-service/.env.example).
# Also baked into the built bundle — anyone with the hosted link can read it and
# call the API as the shared dev-student-001 identity. Fine for sharing a demo
# link with testers; never point this at a real Cognito-protected deployment.
VITE_DEV_TOKEN=
